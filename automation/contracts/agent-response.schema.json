{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "productId": {
          "title": "Productid",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "maximum": 99,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "similarityScore": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarityscore"
        }
      },
      "required": [
        "productId",
        "name",
        "quantity"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "productId": {
          "title": "Productid",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "quantity": {
          "maximum": 99,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "productId",
        "name",
        "quantity"
      ],
      "title": "Item",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "ADD_ITEMS",
          "title": "Action",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "action",
        "items"
      ],
      "title": "Proposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "responseType": {
      "enum": [
        "ANSWER",
        "CLARIFICATION",
        "CART_PROPOSAL",
        "NO_MATCH",
        "REFUSAL",
        "ERROR"
      ],
      "title": "Responsetype",
      "type": "string"
    },
    "message": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "requiresConfirmation": {
      "title": "Requiresconfirmation",
      "type": "boolean"
    },
    "correlationId": {
      "title": "Correlationid",
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Proposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 12,
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "responseType",
    "message",
    "requiresConfirmation",
    "correlationId",
    "proposal",
    "candidates"
  ],
  "title": "AssistantResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://share-my-bread.example/schemas/agent-response.schema.json"
}

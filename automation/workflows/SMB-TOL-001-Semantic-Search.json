    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body ?? $json;\nif (!body || typeof body !== 'object') throw new Error('A JSON request body is required');\nconst query = String(body.query ?? '').trim();\nif (query.length < 2 || query.length > 200) throw new Error('query must contain 2-200 characters');\nconst limit = body.limit ?? 5;\nif (!Number.isInteger(limit) || limit < 1 || limit > 10) throw new Error('limit must be an integer from 1 to 10');\nreturn [{ json: { query, limit } }];"
      },
      "id": "30000000-0000-4000-8000-000000000002",
      "name": "Validate Search Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -430,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SMB_BACKEND_URL + \"/api/guardrails/check\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stage: \"input\", text: $json.query }) }}",
        "options": {
          "timeout": 20000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "id": "30000000-0000-4000-8000-000000000009",
      "name": "Check Search Input",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -300,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if (!['passed', 'modified'].includes($json.status) || typeof $json.text !== 'string' || $json.text.trim().length < 2 || $json.text.length > 200) throw new Error('Search safety check failed');\nreturn [{ json: { query: $json.text, limit: $('Validate Search Request').first().json.limit } }];"
      },
      "id": "30000000-0000-4000-8000-000000000010",
      "name": "Use Checked Search Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

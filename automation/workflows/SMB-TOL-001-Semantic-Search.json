        -100,
        220
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const hits = $input.all();\nif (hits.length > 10) throw new Error('Too many catalogue hits');\nconst ids = hits.filter(item => Object.keys(item.json).length > 0).map(item => {\n  const doc = item.json.document ?? item.json;\n  const id = doc.metadata?.productId;\n  if (typeof id !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) throw new Error('Invalid catalogue hit');\n  return id;\n});\nreturn [{ json: { productIds: [...new Set(ids)] } }];"
      },
      "id": "30000000-0000-4000-8000-000000000005",

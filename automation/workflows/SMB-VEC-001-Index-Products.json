{
  "name": "SMB-VEC-001-Index-Products",
  "nodes": [
    {
      "parameters": {},
      "id": "20000000-0000-4000-8000-000000000001",
      "name": "When clicking Test workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "products",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "active",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "id": "20000000-0000-4000-8000-000000000002",
      "name": "Get Active Products",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(({ json: p }) => ({\n  json: {\n    ...p,\n    documentText: [\n      'Product: ' + p.name,\n      'SKU: ' + p.sku,\n      'Category: ' + p.category,\n      'Description: ' + (p.description || ''),\n      'Aliases and regional names: ' + (Array.isArray(p.aliases) ? p.aliases.join(', ') : ''),\n      'Dietary tags: ' + (Array.isArray(p.dietary_tags) ? p.dietary_tags.join(', ') : ''),\n      'Unit: ' + p.unit\n    ].join('\\n')\n  }\n}));"
      },
      "id": "20000000-0000-4000-8000-000000000003",
      "name": "Prepare Product Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "value": "enterprise-architecture-rag",
          "mode": "id"
        },
        "embeddingBatchSize": 30,
        "options": {
          "pineconeNamespace": "share-my-bread-demo",
          "clearNamespace": true
        }
      },
      "id": "20000000-0000-4000-8000-000000000004",
      "name": "Upsert Products to Pinecone",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "id": "20000000-0000-4000-8000-000000000005",
      "name": "Gemini Product Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.documentText }}",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "productId",
                "value": "={{ $json.id }}"
              },
              {
                "name": "sku",
                "value": "={{ $json.sku }}"
              },
              {
                "name": "name",
                "value": "={{ $json.name }}"
              },
              {
                "name": "category",
                "value": "={{ $json.category }}"
              },
              {
                "name": "unit",
                "value": "={{ $json.unit }}"
              },
              {
                "name": "active",
                "value": "={{ $json.active }}"
              }
            ]
          }
        }
      },
      "id": "20000000-0000-4000-8000-000000000006",
      "name": "Product Document Loader",

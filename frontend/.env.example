NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Use the production URL shown by n8n after the workflow is published.
N8N_AGENT_WEBHOOK_URL=https://your-n8n-host/webhook/smb-assistant

# Optional. Set only when the n8n webhook checks the same request header.
N8N_WEBHOOK_SECRET=

# Server-only. Guarded is the default; baseline explicitly bypasses checks for evaluations.
ASSISTANT_GUARDRAILS_MODE=guarded
# Must match backend GUARDRAILS_API_SECRET; never prefix with NEXT_PUBLIC_.
GUARDRAILS_API_SECRET=

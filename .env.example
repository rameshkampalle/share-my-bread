# Application
APP_ENV=
APP_NAME=Share My Bread
APP_VERSION=
LOG_LEVEL=
DEFAULT_TIMEZONE=

# Frontend public configuration
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
API_BASE_URL=
CORS_ALLOWED_ORIGINS=
DATABASE_URL=

# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n integration
N8N_AGENT_WEBHOOK_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSION=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=share-my-bread-products
PINECONE_NAMESPACE=demo
PINECONE_VECTOR_DIMENSION=
PINECONE_DISTANCE_METRIC=cosine

# Feature controls
AI_ASSISTANT_ENABLED=true
SEMANTIC_SEARCH_ENABLED=true
DEV_FULFILMENT_MODE=true
RETAILER_INTEGRATION_MODE=mock
PAYMENT_MODE=cash

# ElevenLabs — Render/backend only; never use NEXT_PUBLIC_ for these values.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
# Requests always disable provider logging. Account must support zero retention.
